# Function SECRETS. Set with:  supabase secrets set --env-file supabase/.env.local
# NEVER commit supabase/.env.local. Never put these in VITE_* or frontend code.

ELEVENLABS_API_KEY=
ELEVENLABS_MOTHER_AGENT_ID=
ELEVENLABS_FATHER_AGENT_ID=

# Optional CORS origin for Edge Functions (your deployed app URL).
ALLOWED_ORIGIN=*
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
