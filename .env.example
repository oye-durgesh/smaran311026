# Copy to .env.local for local development. NEVER commit a real .env file.
# Public values only (shipped to the browser). Leave blank to run in local demo mode.

VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private keys belong ONLY in supabase/.env.local (function secrets).
# Never put ELEVENLABS_API_KEY or SARVAM_API_KEY in VITE_* variables or frontend code.
# SARVAM_API_KEY is used by the extract-prescription Edge Function only.
